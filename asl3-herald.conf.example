# asl3-herald.conf — Enhanced Tail Message & Announcement Daemon
# Copy to /etc/asterisk/scripts/asl3-herald/asl3-herald.conf and edit.

# Your ASL3 node number (required — install.sh normally prompts for this and
# fills it in automatically; if left blank, the daemon will refuse to start)
Node: ""

# Enable debug logging (set true only for troubleshooting)
Debug: false

# ── Asterisk Manager Interface (AMI) ──────────────────────────────────────────
# AMI enables real-time, low-latency unkey detection and network keyup support.
# The connection is local-only (127.0.0.1) — no internet access involved.
# Herald reads AMI credentials automatically from the system at startup and on
# every SIGHUP reload — you do NOT store them here. Sources, in order:
#   1. /etc/allmon3/allmon3.ini   (Allmon3 users — already configured)
#   2. /etc/asterisk/manager.conf (Supermon / other frontends, or Allmon3 fallback)
# If neither file yields usable credentials, Herald falls back to the legacy
# CLI kerchunk-counter method (local RF unkeys only, ~1s latency).

TailMessage:
  # Enable/disable the tail message function entirely
  Enable: true

  # Minimum seconds between tail messages (prevents rapid replay)
  # This is in SECONDS, not milliseconds like rpt.conf's tailmessagetime.
  # Examples: 5 min = 300 | 10 min = 600 | 15 min = 900
  MinInterval: 300

  # When enabled, tail messages also fire after a network-connected node
  # unkeys (not just local RF). Requires AMI (see above).
  # Default: false (local RF only, matching legacy behavior)
  NetworkKeyupTrigger: true

  # Rotating tail message files (played in order, then repeats). Empty by
  # default — add your own via `herald add`/`herald add-file` or the web UI,
  # or uncomment/edit an example below once the file actually exists.
  # TTS-generated entries also store Text/Voice so they can be edited later
  # (via `herald edit-rotation` or the web UI) without retyping the text;
  # file-uploaded entries just have File and can still be renamed.
  Rotation: []
    # - File: /etc/asterisk/scripts/asl3-herald/announcements/tail1.wav
    #   Text: "This station is running asl3-herald"
    #   Voice: en_US-lessac-medium
    #   # Optional: TTS speech-speed multiplier, 0.5-2.0, default 1.0
    #   # (1.5 = 1.5x normal speed, 0.5 = half speed). Ignored on
    #   # file-uploaded entries. Only takes effect the next time this
    #   # entry's audio is (re)generated.
    #   Speed: 1.0
    # - File: /etc/asterisk/scripts/asl3-herald/announcements/tail2.wav
    #   Text: null
    #   Voice: null
    # - File: /etc/asterisk/scripts/asl3-herald/announcements/tuesday-net.wav
    #   # Optional: only eligible on the days/time-window given below (omit
    #   # either field for "always eligible", the pre-existing behavior).
    #   Days: ["tuesday"]
    #   TimeStart: "18:00"
    #   TimeEnd: "21:00"
    #   # Optional: target a specific node number instead of this daemon's
    #   # configured Node above (for multinodes= setups where one AMI
    #   # connection serves several node numbers).
    #   Node: "12345"
    #   # Optional: set to false to pause this entry without deleting it -
    #   # defaults to true. Toggle via the web UI or
    #   # `herald toggle-rotation <name>`.
    #   Enabled: true

  SkywarnPlus:
    # Play the WX tail file instead of rotation when WX alerts are active.
    # It's a large file (>5000 bytes) when alerts are present, silent when not.
    # WX alerts always take priority over the rotation.
    Enable: true
    # Default matches SkywarnPlus-NG's own default Tail Message File Path -
    # if you're on the classic SkywarnPlus fork instead, set this to
    # /tmp/SkywarnPlus/wx-tail.wav (or wherever its config.yaml points).
    WxTailFile: /var/lib/skywarnplus-ng/data/wx-tail.wav
    # File size threshold to distinguish an active alert file from the silent placeholder
    SilenceThreshold: 5000
    #
    # SkywarnPlus-NG (https://github.com/hardenedpenguin/SkywarnPlus-NG) writes
    # WxTailFile above itself - no bridge needed for that part. BUT it rewrites
    # that file on every poll cycle even when nothing changed (unlike the
    # classic fork, which only rewrites on a real change), which would break
    # the WX/rotation alternation above if Herald relied on the file's mtime
    # like it does for the classic fork. When NGEnable is true, Herald instead
    # polls NG's local dashboard API just to detect genuine alert-set changes,
    # and uses that instead of the file's mtime for the alternation decision.
    NGEnable: false
    NGApiBase: http://127.0.0.1:8100
    NGPollIntervalSec: 30

# Scheduled announcements — play at specific times, regardless of tail message interval
# Name: unique label, used to reference this entry (toggle/edit/remove).
# Cron: standard 5-field cron expression: "minute hour day-of-month month
#   day-of-week" (e.g. "30 7 * * 6" = 7:30 AM every Saturday). This is the
#   primary way to schedule an entry - the web UI and `herald add-schedule`
#   both require Cron for new entries. (Legacy Time/Days/Week fields from
#   older versions still work on existing entries - see the commented-out
#   example below - and are converted to an equivalent Cron expression
#   internally, but can't be used to create new entries.)
# PlayMode (optional): "local" (default, this node only via `rpt localplay`) or
#   "global" (all connected/linked nodes via `rpt playback`).
# Text/Voice (optional): stored for TTS-generated entries so they can be
#   edited later (via `herald edit-schedule` or the web UI) without retyping.
# Speed (optional): TTS speech-speed multiplier, 0.5-2.0, default 1.0.
#   Ignored on file-uploaded entries.
# Node (optional): target a specific node number instead of this daemon's
#   configured Node above (for multinodes= setups).
# Enabled (optional): defaults to true. Set to false to pause this entry
#   without deleting it. Toggle via the web UI or
#   `herald toggle-scheduled <name>`.
# A scheduled announcement waits for the node to unkey before playing if it's
# currently keyed (rather than interrupting live traffic), and always takes
# precedence over a tail message due at the same moment - the tail message
# just retries on its next unkey, with no penalty against MinInterval.
# Empty by default — add your own via `herald add-schedule`/`herald add-schedule-file`
# or the web UI, or uncomment/edit an example below once the file actually exists.
Scheduled: []
  # - Name: "ARRL Audio News"
  #   Cron: "30 7 * * 6"          # Saturdays at 7:30 AM
  #   File: /etc/asterisk/scripts/asl3-herald/announcements/arrl-news.wav
  #   PlayMode: local
  #   Speed: 1.0
  #   Enabled: true

  # - Name: "Weekly Net Announcement"
  #   Cron: "45 19 * * 4"         # Thursdays at 7:45 PM
  #   File: /etc/asterisk/scripts/asl3-herald/announcements/net-announcement.wav
  #   PlayMode: global
  #   Text: "Weekly net announcement text follows"
  #   Voice: en_US-lessac-medium
  #   Enabled: true

  # - Name: "Second Saturday Breakfast Net"
  #   Cron: "0 8 8-14 * 6"        # 2nd Saturday (DOM 8-14, DOW 6) at 8:00 AM
  #   File: /etc/asterisk/scripts/asl3-herald/announcements/breakfast-net.wav
  #   PlayMode: local
  #   Enabled: true

  # - Name: "Legacy-style entry (still supported, but new entries use Cron above)"
  #   Time: "08:00"
  #   Days: ["saturday"]
  #   Week: 2
  #   File: /etc/asterisk/scripts/asl3-herald/announcements/legacy-example.wav
  #   PlayMode: local

# Time & Weather Announcements — a time and/or current-conditions announcement,
# generated fresh every time it plays (not a fixed file like
# Rotation/Scheduled). Takes priority over Scheduled Announcements when both
# are due at the same moment (Scheduled just retries on the next poll cycle).
TimeWeather:
  Enable: false

  # "recordings" - built from the pre-recorded sound pack below (fast,
  #                fixed wording, no TTS engine required).
  # "template"   - one or more of your own text messages (see Templates
  #                below), rendered fresh each time with Piper TTS. Lets you
  #                write your own wording and insert live data with tags.
  Mode: recordings

  # ── Recordings mode settings (ignored when Mode: template) ────────────────

  # Include the time announcement. Independent of Weather.Enable below - any
  # combination is valid (time only, weather only, or both).
  AnnounceTime: true

  # "12" = 12-hour time + AM/PM
  # "24" = 24-hour time
  # Also used to format the {time} tag in Template mode, below.
  TimeFormat: "12"

  # At the exact top of the hour (e.g. 3:00) in 12-hour format, say "Three
  # O'Clock PM" instead of just "Three PM". No effect any other minute, and
  # no effect in 24-hour format (which always says "hundred hours" at :00,
  # e.g. "sixteen hundred hours" - not a toggle, matches the original
  # Time-Weather-Announce script's convention). Also applies to the {time}
  # tag in Template mode, below.
  UseOclock: false

  # "oh" or "zero" - how a single-digit minute is spoken, e.g. "four oh six"
  # vs "four zero six" (12-hour) or "sixteen oh six" vs "sixteen zero six"
  # (24-hour). Only affects the {time} tag in Template mode - Recordings
  # mode always uses "oh" (no "zero" recording exists in the sound pack).
  MinuteZeroWord: "oh"

  # Play "Good morning/afternoon/evening" before the time, based on the hour.
  # Independent of TimeFormat - works with either 12- or 24-hour time.
  SmartGreeting: true

  # Same cron format as Scheduled Announcements above. Default: top of every hour.
  Schedule:
    Cron: "0 * * * *"

  Weather:
    Enable: true

    # auto          - ICAO airport codes use METAR (falling back to Open-Meteo),
    #                 everything else uses Open-Meteo (falling back to METAR)
    # metar         - Force NOAA METAR (ICAO airport codes only)
    # openmeteo     - Force Open-Meteo (free, no API key, any ZIP/postal/ICAO code)
    # tempest       - Your own WeatherFlow Tempest station (requires Tempest.Token below)
    # wunderground  - Any Personal Weather Station uploading to Weather Underground
    #                 (requires Wunderground.ApiKey/StationID below) - including a
    #                 Tempest station also configured to feed WU, not just WU-native
    #                 hardware. No condition text available from this API.
    Provider: auto

    # ZIP/postal code or ICAO airport code (e.g. "92320" or "KONT").
    # Ignored for the tempest and wunderground providers.
    Location: ""

    TemperatureUnit: F  # F or C

    AnnounceCondition: true    # "weather conditions clear/rain/cloudy/..."
    AnnounceFeelsLike: false   # also announce feels-like temperature, if available
    AnnounceHumidity: false    # also announce humidity percentage, if available

    # How fresh (minutes) the last successful weather reading must be before
    # fetching again. Independent of how often the announcement itself plays.
    CacheMaxAgeMin: 10

    Tempest:
      Token: ""       # WeatherFlow Personal Access Token — tempest.earth/account
      StationID: ""   # leave blank to auto-detect (cached after first lookup)

    Wunderground:
      ApiKey: ""      # weatherunderground.com/member/api-keys
      StationID: ""   # e.g. KCASTATION1

    # Writes a small current-conditions JSON snapshot for other local
    # programs to read (e.g. ASL3-SkywarnPlus-NG-Bridge for the Allmon3
    # panel, and install.sh's own Supermon weather-line wrapper — see that
    # repo's README, "Weather snapshot contract"). Reuses this section's own
    # cached fetch above (CacheMaxAgeMin), so enabling this does not cause
    # any extra API calls beyond what Time & Weather's own announcements
    # already make. Checked once a minute internally.
    #
    # Deliberately NOT under /tmp: Debian/Ubuntu's default apache2.service
    # sets PrivateTmp=true, which gives Apache (and anything it exec()s,
    # e.g. Supermon's link.php calling the weather-line wrapper) its own
    # isolated /tmp — a file written to the real /tmp by this daemon would
    # be invisible to it. If you change this path, keep it off /tmp/ and
    # /var/tmp/ for the same reason, and update ASL3-SkywarnPlus-NG-Bridge's
    # Weather.JsonPath to match.
    SnapshotEnable: false
    SnapshotPath: /etc/asterisk/scripts/asl3-herald/weather.json
    SnapshotLabel: ""   # optional, shown on the Allmon3 panel e.g. "Home Station"

  # ── Template mode settings (ignored when Mode: recordings) ────────────────
  # Requires Piper TTS (installed by install.sh). Weather.* above still
  # applies — a message using {temperature}/{conditions}/etc. needs
  # Weather.Enable: true and a working provider configured above.
  Templates:
    # Your callsign, inserted verbatim wherever a message uses {callsign} -
    # you write the rest of the sentence (e.g. "... the {callsign} repeater
    # ..."). If Piper mispronounces it as a run-together word, separate the
    # letters with spaces here (e.g. "W 1 A B C" instead of "W1ABC") - it'll
    # be spoken exactly as typed.
    Callsign: ""

    # How many seconds before a message is due to play the daemon starts
    # rendering it with Piper, so playback is instant at the actual
    # scheduled moment instead of waiting on TTS. Raising this gives more
    # safety margin on a slow/loaded system, at the cost of the {time} and
    # weather data being computed that many seconds earlier than the real
    # play moment.
    LookaheadSeconds: 5

    # One or more messages; a different Enabled one is picked at random each
    # occurrence (never the same one twice in a row if there's more than
    # one). Available tags: {smart_greeting} {time} {conditions}
    # {temperature} {feels_like} {humidity} {wind_speed} {wind_gust} {callsign}
    # A tag left blank because the current provider/reading has no data for
    # it (e.g. no gust, or a provider with no wind at all) is silently
    # omitted rather than failing the whole message.
    #   Id      - auto-generated if omitted; leave as-is once set, used
    #             internally to reference/edit/toggle this specific message.
    #   Speed   - optional, defaults to 1.0. TTS speech-speed multiplier,
    #             0.5-2.0 (1.5 = 1.5x normal speed, 0.5 = half speed).
    #   Enabled - optional, defaults to true. Set to false to remove a
    #             message from the random rotation without deleting it.
    Messages: []
    # Example:
    # Messages:
    #   - Id: "a1b2c3d4"
    #     Text: "{smart_greeting}, welcome to the {callsign} repeater. The time is {time}. Current conditions are {conditions}, {temperature} degrees."
    #     Voice: en_US-amy-medium
    #     Speed: 1.0
    #     Enabled: true

# Node ID — generates the audio content of a single WAV file with Piper TTS
# (herald set-node-id / the web UI's Node ID tab). Herald never touches
# rpt.conf or app_rpt's own idtime/politeid timing - only the content of
# this one file. Point your own `idrecording =` line at it (see README's
# "Node ID" section for the exact line + reload instructions) and reload
# app_rpt after every regeneration.
#
# Not meant to be hand-edited - Text/Voice/Speed/GeneratedAt are written by
# `herald set-node-id`, kept here only so the web UI can show what's
# currently deployed. Speed is the same 0.5-2.0 TTS speech-speed multiplier
# used elsewhere, default 1.0.
NodeID:
  Text: ""
  Voice: en_US-amy-medium
  Speed: 1.0
  GeneratedAt: null
